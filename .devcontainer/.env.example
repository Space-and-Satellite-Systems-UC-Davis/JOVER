# Optional environment overrides for the devcontainer.
# This file is copied to `.devcontainer/.env` on first run.
VNC_PASSWORD=

# GitHub Container Registry authentication                                                                                                                    
# Create a Personal Access Token (Classic) at: https://github.com/settings/tokens                                                                             
# Required scopes: write:packages, read:packages                                                                                                              
GITHUB_USERNAME=                                                                                                                                              
GITHUB_TOKEN=   