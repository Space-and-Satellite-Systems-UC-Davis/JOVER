---
Checks: '*,-modernize-use-trailing-return-type,-llvmlibc-*,-altera-*,-fuchsia-*'
HeaderFilterRegex: '^((?!\/usr\/|\/opt\/ros\/).)*$'
WarningsAsErrors: ''
FormatStyle: none
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
